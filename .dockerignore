# Everything the build does not need. Smaller context = faster builds, and
# nothing secret or huge can be copied into an image by accident.
.git
.github
.skills
docs
grafana
prometheus
migrations/*.down.sql

# 7MB of generated load-test identities carrying signed JWTs. Regenerated by
# `make load-seed`; it must never reach an image.
scripts/k6/seed.json

# Secrets, always.
.env
.env.*
*.pem
*.key

# Local noise.
.DS_Store
.idea
.vscode
*.test
*.out
coverage.*
bin/
