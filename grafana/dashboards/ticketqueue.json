          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 404,
      "title": "Resolutions by source and outcome",
      "description": "Who is fixing stuck bookings and how it ends. A spike in hold_expiry means reconciliation is falling behind and the backstop is carrying it; a spike in deferred means the provider is in trouble and nothing is being guessed.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (source, outcome) (rate(reconciliation_resolution_total[5m]))",
          "legendFormat": "{{source}} / {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
