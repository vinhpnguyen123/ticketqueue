          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 405,
      "title": "Inventory drift corrections",
      "description": "Times Redis disagreed with Postgres twice running and was corrected. Should sit at ~0; a rising line is a real finding.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 8
