    {
      "id": 403,
      "title": "Bookings held / stuck",
      "description": "In-flight holds and the admin stuck list. A rising held line means a resolution path is falling behind or the provider is down.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "bookings_held_current",
          "legendFormat": "held now",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "admin_stuck_bookings_current{category=\"held_too_long\"}",
          "legendFormat": "held too long",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
